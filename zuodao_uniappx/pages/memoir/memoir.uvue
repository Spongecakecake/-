        flex: 1;
        background-color: #101613;
    }
    .loading-wrap {
        flex: 1;
        align-items: center;
        justify-content: center;
    }
    .loading-text {
        font-size: 26rpx;
        color: #C0C9C2;
    }
    .scroll-dark {
        flex: 1;
        padding: 16rpx 40rpx 120rpx;
    }
    .prologue {
        align-items: center;
        margin-top: 16rpx;
    }
    .pro-label {
        font-size: 24rpx;
        font-weight: 600;
        color: #B9E7CF;
    }
    .pro-title {
        font-size: 52rpx;
        font-weight: 700;
        color: #E1E3DC;
        margin-top: 16rpx;
    }
    .pro-parts {
        font-size: 24rpx;
        color: #C0C9C2;
        margin-top: 16rpx;
    }
    .pro-line {
        width: 112rpx;
        height: 4rpx;
        border-radius: 2rpx;
        background-color: #1E4B3A;
        margin-top: 28rpx;
    }
    .chapter {
        background-color: #1B231E;
        border-radius: 32rpx;
        padding: 32rpx;
        margin-top: 40rpx;
    }
    .ch-no {
        font-size: 24rpx;
        font-weight: 700;
        color: #B9E7CF;
    }
    .ch-title {
        font-size: 36rpx;
        font-weight: 600;
        color: #E1E3DC;
        margin-top: 8rpx;
    }
    .ch-text {
        font-size: 28rpx;
        color: #C0C9C2;
        line-height: 48rpx;
        margin-top: 16rpx;
    }
    .epilogue {
        align-items: center;
        margin-top: 56rpx;
    }
    .seal-end {
        width: 108rpx;
        height: 108rpx;
        border-radius: 24rpx;
        background-color: #A63E2C;
        align-items: center;
        justify-content: center;
    }
    .seal-end-text {
        font-size: 44rpx;
        font-weight: 700;
        color: #FFFFFF;
    }
    .ep-note {
        font-size: 24rpx;
        color: #C0C9C2;
        margin-top: 16rpx;
    }
</style>
